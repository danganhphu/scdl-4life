<Project>
  <PropertyGroup Label="Framework">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Label="Build">
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- The boolean one. WarningsAsErrors takes a list of IDs, so setting that
         to "true" escalates nothing at all. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- A CVE published against a transitive package should not break an
         unrelated build the morning it lands. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>

    <!-- Without it the compiler never binds doc comments, so the doc analyzers
         go quiet on the build while the IDE keeps reporting them. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="CodeAnalysis">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <!-- Every project, not just the one that publishes AOT: a library reaching
       for reflection is far cheaper to catch here than at publish time. -->
  <PropertyGroup Label="Aot">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- MinVer reads the nearest v* tag, so no file declares a version. A shallow
       clone has no tags and fails the build, hence fetch-depth 0 everywhere. -->
  <PropertyGroup Label="Versioning">
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <Authors>danganhphu</Authors>
    <RepositoryUrl>https://github.com/danganhphu/scdl-4life</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
