<Project>
  <PropertyGroup Label="Framework">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Label="Build">
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Every warning is an error, the way microsoft/aspire does it. This is the
         boolean property; the similarly named WarningsAsErrors takes a LIST of
         warning IDs (plus the token "nullable"), so <WarningsAsErrors>true</...>
         silently escalates nothing because "true" is not a warning ID. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- The one class of warning that arrives from outside the code: a new CVE
         advisory against a transitive package would otherwise break an unrelated
         build the morning it is published. They stay visible as warnings. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>

    <!-- On by default for every project, including any added later. Without it
         the compiler never binds doc comments, so the doc-comment analyzers are
         silently dead on the build while Rider still reports them - the IDE and
         CI quietly disagreeing about the same code. Projects that genuinely do
         not want it opt out explicitly. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="CodeAnalysis">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>

    <!-- CodeAnalysisTreatWarningsAsErrors is deliberately absent: it only covers
         CA rules, and TreatWarningsAsErrors above already covers everything. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <PropertyGroup Label="Aot">
    <!-- Every project is held to AOT and trim rules, not just the one that
         publishes AOT. A library that quietly reaches for reflection is far
         cheaper to catch here than at publish time. The test project opts out,
         because Moq builds proxies at runtime. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Analyzers live in Directory.Packages.props as GlobalPackageReference.
       That item type exists for exactly this case and already implies
       PrivateAssets="all" plus the right IncludeAssets, so there is nothing to
       restate - or get wrong - here. -->

  <PropertyGroup Label="Packaging">
    <Authors>danganhphu</Authors>
    <RepositoryUrl>https://github.com/danganhphu/scdl-4life</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>