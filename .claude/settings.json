{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet tool restore)",
      "Bash(dotnet tool run:*)",
      "Bash(dotnet --info)",
      "Bash(dotnet --list-sdks)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(./**/*.pfx)",
      "Read(./**/*.snk)",
      "Read(./**/.env)",
      "Read(./**/*.local.json)"
    ]
  }
}
