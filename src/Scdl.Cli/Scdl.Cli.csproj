<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!-- The only override that earns its place: the command is `scdl`, not
         `Scdl.Cli`. RootNamespace stays at its default. -->
    <AssemblyName>scdl</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="NativeAot">
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <InvariantTimezone>true</InvariantTimezone>

    <!-- Size over startup latency: this is a short lived CLI, so the extra
         optimisation time at publish is paid once and the smaller binary is
         paid on every copy. -->
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>

    <!-- Fail the publish on a trim or AOT warning rather than shipping a binary
         that throws only once it reaches a reflection path at runtime. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <!-- Builds README.md from readme.source.md, pulling every code block straight
       out of the compiled sources. Docs that quote real code cannot drift from
       it. Only one project needs to host this, or it would run once per
       project over the same files. -->
  <ItemGroup>
    <PackageReference Include="MarkdownSnippets.MsBuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- No MarkdownSnippets properties are set, and that is deliberate. The task
       hardcodes ProjectDirectory and finds the repo root itself, and its
       ReadOnly and WriteHeader parameters are declared as bool?, which MSBuild
       on .NET 10 cannot convert a value into - setting either one fails the
       build with MSB4030. Leaving them empty is the only working configuration. -->

  <ItemGroup>
    <ProjectReference Include="..\Scdl.Core\Scdl.Core.csproj" />
  </ItemGroup>

</Project>
