<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Microsoft Extensions">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Cli">
    <!-- Parsing is System.CommandLine because Spectre.Console.Cli is documented
         as neither trimmable nor AOT appropriate. Spectre renders only. -->
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup Label="Media">
    <!-- ATL parses containers in managed code, so it survives trimming. -->
    <PackageVersion Include="z440.atl.core" Version="7.17.0" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.0" />
    <GlobalPackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup Label="Versioning">
    <GlobalPackageReference Include="MinVer" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Label="Docs">
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="28.4.2" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="TUnit" Version="1.68.4" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Bogus" Version="35.6.5" />

    <!-- Must stay pinned to the Spectre.Console version above: TestConsole
         implements IAnsiConsole, which is not stable across releases. -->
    <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
  </ItemGroup>
</Project>
